# Copy to .env (git-ignored) and adjust. There are no secrets here: Azure access is Entra ID (`az login`) + RBAC,
# and the Azure endpoints are written to .env.azure by `make env-from-tf`.

# --- which stack (each one switches independently) ---
SEARCH_PROVIDER=local            # local (own BM25 + Qdrant) | azure_search
EMBED_PROVIDER=local             # local (bge-small) | azure_openai (text-embedding-3-small, needs azure_search)
LLM_PROVIDER=ollama              # ollama | transformers | bedrock | azure_openai | fake

# --- local models ---
LLM_MODEL=qwen3:4b               # ollama tag / HF repo id
OLLAMA_URL=http://localhost:11434
EMBED_BACKEND=onnx               # onnx (no PyTorch) | torch
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNKING=section
# QDRANT_URL=http://localhost:6333   # unset = embedded local Qdrant in data/qdrant

# --- Azure (names; the endpoints come from .env.azure) ---
AZURE_SEARCH_INDEX=chunks-section
AZURE_OPENAI_EMBED_DIMENSIONS=512   # shortened text-embedding-3-small vectors: the Free tier has little vector space
# LLM_TEMPERATURE=none              # only for reasoning models (gpt-5, o-series), which accept no temperature

# --- API ---
ALLOWED_ORIGINS=["http://localhost:5173"]
